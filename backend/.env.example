# Backend environment variables — copy this file to ".env" and fill in your values.

# Port the API server listens on (Render/Railway set this automatically).
PORT=4000

# MongoDB connection string. Get a free cluster at https://www.mongodb.com/atlas
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=

# Cloudinary credentials for storing uploaded images & audio.
# Get them free at https://cloudinary.com (Dashboard → Account Details).
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=
